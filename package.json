{
  "name": "browser-agent-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Type a task, watch Claude do it in a real browser, and stay in control: a Playwright harness for Claude's browser toolset, a live timeline UI with pause, stop and approvals, and a deterministic eval suite.",
  "license": "MIT",
  "author": "Chris Sanborn",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "eval": "tsx evals/run.ts",
    "fixtures": "tsx fixtures/serve.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "capture": "tsx scripts/capture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
